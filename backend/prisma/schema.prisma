generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id               String            @id @default(uuid())
  name             String
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeys          ApiKey[]
  templates        Template[]
  subscribers      Subscriber[]
  topics           NotificationTopic[]
  workflows        Workflow[]
  logs             NotificationLog[]
  providerConfig   ProviderConfig?
  channelProviders ChannelProvider[]
  digestBatches    DigestBatch[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model ApiKey {
  id        String    @id @default(uuid())
  name      String
  hash      String    @unique
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  lastUsed  DateTime?
}

model Template {
  id           String   @id @default(uuid())
  name         String
  channel      String   // email, sms, webhook, in_app
  subject      String?  // for email
  body         String   // text/HTML template
  placeholders String[] // extracted variables e.g. ["name", "orderId"]
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Subscriber {
  id           String                 @id @default(uuid())
  subscriberId String                 // Customer app user identifier (e.g. "user_10293")
  email        String?
  phone        String?
  firstName    String?
  lastName     String?
  avatar       String?
  locale       String?                @default("en")
  timeZone     String?
  data         Json?                  // Custom metadata JSON
  projectId    String
  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  preferences  SubscriberPreference[]
  inAppMessages InAppMessage[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([projectId, subscriberId])
}

model NotificationTopic {
  id          String                 @id @default(uuid())
  key         String                 // e.g. "product_updates", "security_alerts", "billing"
  name        String                 // Display name e.g. "Security Alerts"
  description String?
  projectId   String
  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  preferences SubscriberPreference[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([projectId, key])
}

model SubscriberPreference {
  id           String             @id @default(uuid())
  subscriberId String
  subscriber   Subscriber         @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  topicId      String?
  topic        NotificationTopic? @relation(fields: [topicId], references: [id], onDelete: Cascade)
  channel      String             // "email", "sms", "in_app", "webhook"
  enabled      Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([subscriberId, topicId, channel])
}

model Workflow {
  id                String        @id @default(uuid())
  name              String
  triggerIdentifier String        // Unique string used to fire the workflow (e.g., "user-welcome", "cart-abandoned")
  description       String?
  active            Boolean       @default(true)
  steps             Json          // Sequence of step objects (email, sms, delay, in_app, webhook, digest)
  projectId         String
  project           Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs              WorkflowRun[]
  digestBatches     DigestBatch[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([projectId, triggerIdentifier])
}

model WorkflowRun {
  id               String   @id @default(uuid())
  workflowId       String
  workflow         Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  subscriberId     String
  projectId        String
  currentStepIndex Int      @default(0)
  status           String   @default("pending") // pending, processing, completed, failed, paused
  payload          Json?
  logs             Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model InAppMessage {
  id           String     @id @default(uuid())
  subscriberId String
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  title        String
  body         String
  read         Boolean    @default(false)
  readAt       DateTime?
  data         Json?
  projectId    String
  createdAt    DateTime   @default(now())
}

model ProviderConfig {
  id            String   @id @default(uuid())
  smtpHost      String?
  smtpPort      Int?
  smtpUser      String?
  smtpPass      String?
  twilioSid     String?
  twilioToken   String?
  twilioPhone   String?
  webhookSecret String?  @default(uuid())
  projectId     String   @unique
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NotificationLog {
  id        String   @id @default(uuid())
  jobId     String?
  channel   String
  status    String   // queued, processing, sent, failed, dead_lettered, preference_filtered
  recipient String
  payload   Json?
  error     String?
  attempts  Int      @default(1)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ChannelProvider {
  id                 String   @id @default(uuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channel            String   // "email", "sms", "webhook", "in_app"
  providerIdentifier String   // "sendgrid", "ses", "smtp", "twilio", "sns", "custom_webhook"
  credentials        Json     // API keys, SMTP host/port/user/pass, Twilio SID/token, etc.
  priority           Int      @default(1) // 1 = Primary, 2 = Fallback 1, 3 = Fallback 2...
  active             Boolean  @default(true)
  rateLimitPerSecond Int?     @default(10) // Max dispatches per second for this provider
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([projectId, channel, priority])
}

model DigestBatch {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowId   String
  workflow     Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  subscriberId String
  stepIndex    Int
  events       Json     // Array of incoming payloads e.g. [{ orderId: 101 }, { orderId: 102 }]
  status       String   @default("active") // "active", "processing", "completed"
  flushAt      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([projectId, workflowId, subscriberId, stepIndex, status])
}

